    )
  )
)

(rule
  (alias runtest)
  (deps effects_wasm3.act)
  (action (diff expected/effects-wasm-3.0.csv effects_wasm3.act)))
(rule
  (alias runtest)
  (deps effects_wasm3.act check_effects.py)
  (action (run python3 check_effects.py effects_wasm3.act)))

(rule
