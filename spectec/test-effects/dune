)

(rule (alias runtest) (deps atom_sem.act) (action (diff expected/atom_sem.json atom_sem.act)))
(rule
  (alias runtest)
  (deps atom_sem.act check_atoms.py)
  (action (run python3 check_atoms.py atom_sem.act)))
