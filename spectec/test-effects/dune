; Golden and smoke tests for --effects CSV output.
; Run `dune promote` after intentional output changes.

(rule
  (targets effects.act)
  (deps
    (file ../src/exe-spectec/main.exe)
    (glob_files ../../specification/wasm-2.0/*.spectec)
  )
  (action
    (with-stdout-to effects.act
      (system "../src/exe-spectec/main.exe ../../../../specification/wasm-2.0/*.spectec --effects")
    )
  )
)

(rule (alias runtest) (deps effects.act) (action (diff expected/effects.csv effects.act)))
(rule
  (alias runtest)
  (deps effects.act check_effects.py)
  (action (run python3 check_effects.py effects.act)))

